{
  "name": "aml-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive, fully derived learning platform for CS 5785 Applied Machine Learning (Cornell Tech, Fall 2026)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:content && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check . && pnpm check:colors",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "prepare": "lefthook install",
    "check:colors": "tsx scripts/check-colors.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "astro-expressive-code": "0.44.2",
    "clsx": "2.1.1",
    "d3-random": "3.0.1",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "mafs": "0.21.0",
    "oxc-transform-react": "0.153.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-random": "3.0.3",
    "@types/katex": "0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unified": "^11.0.5",
    "vitest": "5.0.3"
  }
}
