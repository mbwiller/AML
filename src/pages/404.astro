---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 font-sans">
    <p class="m-0 text-ui-sm tracking-caps text-muted uppercase">404</p>
    <h1 class="mt-1 text-h1 font-bold tracking-tight">There is no page here</h1>
    <p class="mt-3 max-w-measure font-serif text-body text-muted">
      Some sections of AML Atlas have not been built yet. The Atlas, practice, glossary, homework,
      materials, and cases pages arrive with the next milestones.
    </p>
    <ul class="mt-6 grid gap-2 text-ui-lg">
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/units">Units</a>
      </li>
    </ul>
  </main>
</Base>
