---
import Base from '@/layouts/Base.astro';
import { formatMinutes, lessonHref, lessonNumber } from '@/lib/lessons';
import { getCourseLessons } from '@/lib/site';

export async function getStaticPaths() {
  const { units, lessons } = await getCourseLessons();
  return units.map((unit) => ({
    params: { unit: unit.id },
    props: { unit, lessons: lessons.filter((l) => l.data.unit === unit.id) },
  }));
}
const { unit, lessons } = Astro.props;
---

<Base title={unit.title} description={unit.summary}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10">
    <p class="m-0 font-sans text-ui-sm text-muted">
      <a href="/units" class="text-muted no-underline hover:text-fg">
        Units
      </a>{' '}
      · Unit {unit.order} · {unit.lectures}
    </p>
    <h1 class="mt-1 font-sans text-h1 leading-tight font-bold tracking-tight">{unit.title}</h1>
    <p class="mt-2 max-w-measure text-muted">{unit.summary}</p>
    {lessons.length === 0 ? (
      <p class="mt-8 rounded-card border border-border bg-surface-2 p-4 font-sans text-ui text-muted">
        No lessons in this unit yet.
      </p>
    ) : (
      <ol class="mt-8 m-0 list-none p-0 grid gap-3">
        {lessons.map((l) => (
          <li class="m-0">
            <a
              href={lessonHref(l.data.unit, l.data.slug)}
              class="block rounded-card border border-border bg-surface p-4 text-fg no-underline transition-colors duration-micro ease-standard hover:bg-surface-2"
            >
              <span class="flex items-baseline gap-3 font-sans">
                <span class="text-ui-sm text-muted tabular-nums">
                  {lessonNumber(l.data.unit, l.data.order)}
                </span>
                <span class="text-body-sm font-semibold">{l.data.title}</span>
                <span class="ml-auto text-ui-xs text-muted">
                  {formatMinutes(l.data.estimatedMinutes)}
                </span>
                {l.data.status !== 'published' && (
                  <span class="rounded-full border border-border px-2 py-0.5 text-ui-xs tracking-caps text-muted uppercase">
                    {l.data.status}
                  </span>
                )}
              </span>
              <span class="mt-1 block text-ui-lg text-muted">{l.data.summary}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </main>
</Base>
