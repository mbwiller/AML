---
/**
 * `<Pitfall title="…" misconception="nb-zero-prob">` … `</Pitfall>` — a
 * false belief, stated as the title, then the fix as the body
 * (docs/CONTENT_AUTHORING.md §4). `data-misconception` lets M1 surface the
 * pitfall when a learner picks the matching quiz distractor.
 */
import { renderInlineTex } from '@/lib/markdown/render-tex';

interface Props {
  title: string;
  misconception?: string | undefined;
}
const { title, misconception } = Astro.props;
---

<aside class="pitfall" data-misconception={misconception} aria-label="Pitfall">
  <p class="pitfall-head">
    <span class="pitfall-label">Pitfall</span>
    <span class="pitfall-title" set:html={renderInlineTex(title)} />
  </p>
  <div class="pitfall-body">
    <slot />
  </div>
</aside>

<style>
  .pitfall {
    margin-block: 1.5em;
    padding: 0.75rem 1.25rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .pitfall-head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }
  .pitfall-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pitfall-title {
    font-weight: 600;
  }
  .pitfall-body {
    font-size: 0.9444em;
  }
  .pitfall-body > :global(:first-child) {
    margin-block-start: 0;
  }
  .pitfall-body > :global(:last-child) {
    margin-block-end: 0;
  }
</style>
