---
/**
 * `<Notebook path="Code Companions/Lecture 8 Code Companion.ipynb" cells="9-14" />`
 * — inline chip linking to the notebook's row on /materials
 * (`/materials#notebook-<slug of file name>`; docs/CONTENT_AUTHORING.md §4),
 * where the row says which lectures it implements and links the copied
 * `.ipynb`. Rendering the cells with their outputs is a follow-up.
 */
import { notebookAnchor } from '@/lib/materials';

import Chip from './Chip.astro';

interface Props {
  path: string;
  cells: string;
}
const { path, cells } = Astro.props;
const basename = path.split('/').pop() ?? path;
const cellsText = String(cells).replace(/\s*-\s*/, '–');
const label = cells === undefined ? basename : `${basename} · cells ${cellsText}`;
---

<Chip
  class="notebook"
  href={`/materials#${notebookAnchor(basename)}`}
  title={`Notebook: ${path}`}
  data-notebook={path}
>
  {label}
</Chip>
