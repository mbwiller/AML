---
/**
 * `<HomeworkBridge hw="hw3" skills={["bernoulli-nb-mle", …]} />` — the
 * readiness-gate rows for this lesson's contribution to a homework
 * (docs/CONTENT_AUTHORING.md §4; VISION.md §9.9). M0 lists the skills with
 * empty section and check columns; M1 fills them from the homework map and
 * the practice engine. Never carries answers for a live homework (R17).
 */
interface Props {
  hw: string;
  skills: string[];
}
const { hw, skills = [] } = Astro.props;
const hwLabel = hw.toUpperCase();
const sectionId = `homework-${hw}`;
---

<section
  id={sectionId}
  class="homework-bridge"
  data-homework={hw}
  aria-labelledby={`${sectionId}-title`}
>
  <h3 id={`${sectionId}-title`} class="bridge-title">
    <span class="bridge-label">Readiness gate</span>
    <span class="bridge-name">{hwLabel}</span>
  </h3>
  <table class="bridge-table">
    <thead>
      <tr>
        <th scope="col">Skill</th>
        <th scope="col">Lesson section</th>
        <th scope="col">Check</th>
      </tr>
    </thead>
    <tbody>
      {skills.map((skill) => (
        <tr data-skill={skill}>
          <td>
            <code>{skill}</code>
          </td>
          <td data-skill-section>—</td>
          <td data-skill-check>—</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="bridge-foot">
    <a href={`/homework/${hw}`}>All of {hwLabel}'s readiness checks</a>
  </p>
</section>

<style>
  .homework-bridge {
    margin-block: 2em;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .bridge-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.5em;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .bridge-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bridge-table {
    margin-block: 0.5em;
  }
  .bridge-foot {
    margin: 0.75em 0 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
</style>
