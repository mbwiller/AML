---
/**
 * `<Chunk title="Isolate the terms that involve ψ_jk">` — a group of 3–5
 * steps inside a `<Derivation>` (STYLE_GUIDE.md §2.3). The title names the
 * move, not the math. Renders an `h4` (outline uses h2/h3 only) and an
 * `<ol class="steps">`; numbering continues across chunks.
 */
import { renderInlineTex } from '@/lib/markdown/render-tex';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="chunk" data-chunk>
  <h4 class="chunk-title" set:html={renderInlineTex(title)} />
  <ol class="steps">
    <slot />
  </ol>
</div>

<style>
  .chunk {
    margin-block: 1.25em;
  }
  /* Chunk titles are sentence-case moves, so they do not take the global
     uppercase h4 treatment. */
  .chunk-title {
    margin-block: 0 0.5em;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
