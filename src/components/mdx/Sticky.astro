---
/**
 * Sticky note (VISION.md §9.2): a `[[term]]` from the remark-sticky plugin,
 * never written by hand. Renders the trigger and, once per page per term,
 * the glossary card (`StickyCard.astro`). The popover itself is the vanilla
 * controller in src/components/shell/sticky-controller.ts (included by
 * Base.astro), not a React island: lesson pages ship no React runtime.
 *
 * Trigger contract (reused by prerequisite chips and anything else that
 * wants a sticky): `data-sticky="<glossary id>"`, `data-field="<field>"`,
 * `aria-haspopup="dialog"`, `aria-expanded="false"`, focusable.
 *
 * Underline: dotted, 1px, offset 3px, in the term's field color; the first
 * use in a lesson (`first`) is 2px. Text stays `--fg`. Unknown ids keep the
 * underline in `--muted` and open a "no entry yet" card; the build never fails.
 *
 * The markup line is prettier-ignored: whitespace text nodes around an inline
 * trigger would be underlined or add a space before the next punctuation.
 */
import { glossaryEntry } from '@/lib/site';

import StickyCard from './StickyCard.astro';

interface Props {
  id: string;
  first?: boolean;
}
const { id, first = false } = Astro.props;
const entry = await glossaryEntry(id);
const term = entry?.data;
---

{/* prettier-ignore */}
<Fragment><span class:list={['sticky', { 'sticky-first': first }]} data-sticky={id} data-field={term?.field} role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title={term ? `${term.term} (glossary)` : `Glossary: ${id}`}><slot /></span><StickyCard id={id} /></Fragment>
