---
/**
 * `<Check ids={["q-u6-l3-001", "q-u6-l3-002"]} />` — inline check pulling
 * items from the quiz bank (docs/CONTENT_AUTHORING.md §4, §7; VISION.md §8
 * item 9, §9.5). Items are looked up and rendered at build time; one
 * event-delegated vanilla controller per page grades them in the browser
 * with the same code as `src/lib/graders` (no React on lesson pages).
 *
 * Renders today: `mc` (radios), `numeric` (text input; "New numbers" when
 * the item is seeded), `which-step` (radios over the derivation's steps,
 * read from the lesson body that defines it). Other types and unknown ids
 * render as muted rows and never throw.
 *
 * DOM contract (stable for the practice engine): see README.md "Check".
 */
import { getCollection } from 'astro:content';

import type { QuizItem } from '@/lib/content/schemas';
import { buildWhichStep, extractDerivationSteps, hashSeed } from '@/lib/graders';
import { NUMERIC_FORMAT_HINT } from '@/lib/graders/numeric';
import { derivationTargets } from '@/lib/graders/targets';
import { renderDisplayTex, renderInlineTex } from '@/lib/markdown/render-tex';

interface Props {
  ids: string[];
}
const { ids = [] } = Astro.props;

const [quizzes, lessons, nodes] = await Promise.all([
  getCollection('quizzes'),
  getCollection('lessons'),
  getCollection('graphNodes'),
]);
const bank = new Map(quizzes.map((q) => [q.data.id, q.data]));
const nodeDerivation = new Map<string, string>();
for (const n of nodes) if (n.data.derivation) nodeDerivation.set(n.data.id, n.data.derivation);

/** The steps of a derivation, from whichever lesson body defines it. */
function stepsFor(derivationId: string): string[] | undefined {
  for (const l of lessons) {
    const steps = extractDerivationSteps(l.body ?? '', derivationId);
    if (steps) return steps;
  }
  return undefined;
}

/** Anchors a wrong answer can jump to (src/lib/graders/targets.ts); the controller shows the first on the page. */
const targetsOf = (item: QuizItem, own?: string): string[] =>
  derivationTargets(item, nodeDerivation, own);

const prompt = (text: string | undefined): string =>
  text ? renderInlineTex(text.trim().replace(/\s*\n\s*/g, ' ')) : '';

interface OptionView {
  html: string;
  explanationHtml: string | undefined;
}

type ItemView =
  | { kind: 'missing'; id: string }
  | { kind: 'unsupported'; id: string; type: string; promptHtml: string; note: string }
  | {
      kind: 'mc';
      id: string;
      promptHtml: string;
      options: OptionView[];
      explanationHtml: string;
      client: string;
      seed: number;
      targets: string[];
    }
  | {
      kind: 'numeric';
      id: string;
      promptHtml: string;
      hint: string;
      seeded: boolean;
      explanationHtml: string;
      client: string;
      seed: number;
      targets: string[];
    }
  | {
      kind: 'which-step';
      id: string;
      promptHtml: string;
      steps: { number: number; html: string }[];
      explanationHtml: string;
      client: string;
      seed: number;
      targets: string[];
    };

function view(id: string): ItemView {
  const item = bank.get(id);
  if (!item) return { kind: 'missing', id };
  const seed = hashSeed(id);
  switch (item.type) {
    case 'mc':
      return {
        kind: 'mc',
        id,
        promptHtml: prompt(item.prompt),
        options: item.options.map((o) => ({
          html: renderInlineTex(o.text.trim()),
          explanationHtml: o.explanation ? prompt(o.explanation) : undefined,
        })),
        explanationHtml: prompt(item.explanation),
        client: JSON.stringify({
          type: 'mc',
          options: item.options.map((o) => ({
            ...(o.correct ? { correct: true } : {}),
            ...(o.misconception ? { misconception: o.misconception } : {}),
          })),
        }),
        seed,
        targets: targetsOf(item),
      };
    case 'numeric': {
      const seeded = Boolean(item.seeded && item.formula);
      const tolerance = item.tolerance > 0 ? `within ±${item.tolerance}` : 'exact';
      return {
        kind: 'numeric',
        id,
        promptHtml: prompt(item.prompt),
        hint: `Enter ${NUMERIC_FORMAT_HINT}; ${tolerance}.`,
        seeded,
        explanationHtml: prompt(item.explanation),
        client: JSON.stringify({
          type: 'numeric',
          answer: item.answer,
          tolerance: item.tolerance,
          ...(seeded ? { seeded: item.seeded, formula: item.formula } : {}),
        }),
        seed,
        targets: targetsOf(item),
      };
    }
    case 'which-step': {
      const steps = stepsFor(item.derivation);
      const built = steps ? buildWhichStep(item, steps) : null;
      if (!built) {
        return {
          kind: 'unsupported',
          id,
          type: item.type,
          promptHtml: prompt(item.prompt),
          note: steps
            ? `Step ${item.corrupt.step} is outside the ${steps.length} steps of ${item.derivation}.`
            : `Derivation ${item.derivation} is not in any lesson yet.`,
        };
      }
      return {
        kind: 'which-step',
        id,
        promptHtml:
          prompt(item.prompt) ||
          'One step of this derivation has been changed so that it is wrong. Which one?',
        steps: built.steps.map((s) => ({ number: s.number, html: renderDisplayTex(s.tex) })),
        explanationHtml: prompt(item.corrupt.explanation),
        client: JSON.stringify({ type: 'which-step', corrupt: { step: item.corrupt.step } }),
        seed,
        targets: targetsOf(item, `${item.derivation}-step-${item.corrupt.step}`).concat(
          item.derivation,
        ),
      };
    }
    default:
      return {
        kind: 'unsupported',
        id,
        type: item.type,
        promptHtml: prompt(item.prompt),
        note: `${item.type} items arrive with the practice engine.`,
      };
  }
}

const views = ids.map(view);
---

<section
  class="check"
  data-check
  data-check-ids={ids.join(',')}
  aria-label="Check your understanding"
>
  <p class="check-label">Check your understanding</p>
  <ol class="check-items">
    {views.map((v, i) => {
      const n = i + 1;
      const base = `check-${v.id}`;
      if (v.kind === 'missing') {
        return (
          <li
            class="check-item check-item-muted"
            data-check-item={v.id}
            data-check-supported="false"
          >
            <span class="check-number" aria-hidden="true">
              {n}
            </span>
            <p class="check-muted">
              Item <code>{v.id}</code> is not in the quiz bank yet.
            </p>
          </li>
        );
      }
      if (v.kind === 'unsupported') {
        return (
          <li
            class="check-item check-item-muted"
            data-check-item={v.id}
            data-check-type={v.type}
            data-check-supported="false"
          >
            <span class="check-number" aria-hidden="true">
              {n}
            </span>
            {v.promptHtml && <p class="check-prompt" set:html={v.promptHtml} />}
            <p class="check-muted">{v.note}</p>
          </li>
        );
      }
      const feedback = (
        <div
          class="check-feedback"
          id={`${base}-feedback`}
          role="status"
          data-check-feedback
          hidden
        >
          <p class="check-verdict">
            <svg class="check-icon check-icon-correct" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <svg class="check-icon check-icon-incorrect" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
            <span data-check-verdict />
          </p>
          {v.explanationHtml && (
            <div class="check-explanation" data-check-explanation set:html={v.explanationHtml} />
          )}
          {v.kind === 'mc' &&
            v.options.map(
              (o, j) =>
                o.explanationHtml && (
                  <div
                    class="check-explanation"
                    data-check-option-explanation={j}
                    set:html={o.explanationHtml}
                    hidden
                  />
                ),
            )}
          <p class="check-links">
            <a class="check-link" data-check-pitfall-link hidden>
              See the pitfall
            </a>
            <a class="check-link" data-check-derivation-link hidden>
              Go to the derivation
            </a>
          </p>
        </div>
      );
      const actions = (
        <div class="check-actions">
          <button
            type="submit"
            class="check-button check-button-primary"
            data-check-action="grade"
            aria-label={`Check answer to question ${n}`}
          >
            Check
          </button>
          <button
            type="button"
            class="check-button"
            data-check-action="reset"
            aria-label={`Try question ${n} again`}
            hidden
          >
            Try again
          </button>
          {v.kind === 'numeric' && v.seeded && (
            <button
              type="button"
              class="check-button"
              data-check-action="resample"
              aria-label={`New numbers for question ${n}`}
            >
              New numbers
            </button>
          )}
        </div>
      );
      return (
        <li
          class="check-item"
          id={base}
          data-check-item={v.id}
          data-check-type={v.kind}
          data-check-state="idle"
          data-item={v.client}
          data-shuffle-seed={v.seed}
          data-check-targets={v.targets.join(',') || undefined}
        >
          <form class="check-form" data-check-form novalidate>
            <p class="check-prompt" id={`${base}-prompt`}>
              <span class="check-number" aria-hidden="true">
                {n}
              </span>
              <span class="sr-only">Question {n}. </span>
              <span set:html={v.promptHtml} />
            </p>
            {v.kind === 'mc' && (
              <fieldset
                class="check-options"
                aria-labelledby={`${base}-prompt`}
                aria-describedby={`${base}-feedback`}
              >
                <legend class="sr-only">Options</legend>
                {v.options.map((o, j) => (
                  <label class="check-option">
                    <input type="radio" name={base} value={j} />
                    <span class="check-option-text" set:html={o.html} />
                  </label>
                ))}
              </fieldset>
            )}
            {v.kind === 'which-step' && (
              <fieldset
                class="check-options check-steps"
                aria-labelledby={`${base}-prompt`}
                aria-describedby={`${base}-feedback`}
              >
                <legend class="sr-only">Steps</legend>
                {v.steps.map((s, j) => (
                  <label class="check-option check-step">
                    <input type="radio" name={base} value={j} />
                    <span class="check-step-number" aria-hidden="true">
                      {s.number}
                    </span>
                    <span class="sr-only">Step {s.number}: </span>
                    <span class="check-option-text check-step-math" set:html={s.html} />
                  </label>
                ))}
              </fieldset>
            )}
            {v.kind === 'numeric' && (
              <>
                <p class="check-params" data-check-params hidden>
                  <span class="check-params-label">Use these values instead:</span>{' '}
                  <code data-check-params-list />
                </p>
                <div class="check-answer">
                  <label class="check-answer-label" for={`${base}-input`}>
                    Your answer
                  </label>
                  <input
                    id={`${base}-input`}
                    class="check-input"
                    type="text"
                    name="answer"
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby={`${base}-hint ${base}-feedback`}
                  />
                </div>
                <p class="check-hint" id={`${base}-hint`}>
                  {v.hint}
                </p>
              </>
            )}
            {actions}
            {feedback}
          </form>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .check {
    margin-block: 1.5em;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-2);
    scroll-margin-top: 4rem;
  }
  .check-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .check-items {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .check-item {
    position: relative;
    margin: 0;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: var(--radius-card);
    background: var(--surface);
    transition: border-color var(--duration-micro) var(--ease-standard);
  }
  .check-item[data-check-state='correct'] {
    border-left-color: var(--viz-positive);
  }
  .check-item[data-check-state='incorrect'] {
    border-left-color: var(--viz-negative);
  }
  .check-item-muted {
    border-style: dashed;
    color: var(--muted);
  }
  .check-number {
    position: absolute;
    top: 0.95rem;
    inset-inline-start: 0.75rem;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5rem;
    text-align: center;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .check-prompt {
    margin: 0 0 0.6rem;
    font-size: 0.9444em;
    line-height: 1.55;
  }
  .check-muted {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
  }
