  /* Feedback */
  .check-feedback {
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    animation: check-reveal var(--duration-reveal) var(--ease-standard);
  }
  @keyframes check-reveal {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .check-verdict {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .check-icon {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  [data-check-state='correct'] .check-verdict {
    color: var(--viz-positive);
  }
  [data-check-state='correct'] .check-icon-correct {
    display: inline-block;
  }
  [data-check-state='incorrect'] .check-verdict {
    color: var(--viz-negative);
  }
  [data-check-state='incorrect'] .check-icon-incorrect {
    display: inline-block;
  }
  [data-check-state='invalid'] .check-verdict {
    color: var(--muted);
    font-weight: 500;
  }
  .check-explanation {
    font-family: var(--font-serif);
    font-size: 0.9444em;
  }
  .check-explanation :global(.katex) {
    font-size: 1em;
  }
  .check-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.5rem 0 0;
  }
  .check-links:not(:has(a:not([hidden]))) {
    display: none;
  }
  .check-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (width < 640px) {
    .check {
      padding-inline: 0.875rem;
    }
    .check-item {
      padding-inline: 0.75rem 0.75rem;
      padding-inline-start: 2.5rem;
    }
  }
</style>

<script>
  /**
   * One controller per page for every `<Check>` (event delegation on
   * `document`). Grading state lives in memory only; the practice engine adds
   * persistence. Each graded item dispatches `check:graded` with
   * `{ id, type, correct }` so later features can listen without touching
   * this markup.
   */
  import { grade, hashSeed, sampleSeededParams, type GradableItem } from '@/lib/graders';

  const ITEM = '[data-check-item][data-item]';
  const resamples = new WeakMap<HTMLElement, number>();
  const instances = new WeakMap<HTMLElement, Record<string, number>>();

  const q = <T extends Element>(root: Element, selector: string): T | null =>
    root.querySelector<T>(selector);

  function readItem(li: HTMLElement): GradableItem | null {
    try {
      return JSON.parse(li.dataset['item'] ?? '') as GradableItem;
    } catch {
      return null;
    }
  }

  function chosenIndex(li: HTMLElement): number | null {
    const checked = q<HTMLInputElement>(li, 'input[type="radio"]:checked');
    return checked ? Number(checked.value) : null;
  }

  function firstOnPage(targets: string): { id: string; step: boolean } | null {
    for (const id of targets.split(',')) {
      if (id && document.getElementById(id)) return { id, step: /-step-\d+$/.test(id) };
    }
    return null;
  }

  function pitfallHref(misconception: string): string | null {
    const aside = document.querySelector<HTMLElement>(
      `aside[data-misconception="${CSS.escape(misconception)}"]`,
    );
    if (!aside) return null;
    if (!aside.id) aside.id = `pitfall-${misconception}`;
    return `#${aside.id}`;
  }

  function gradeItem(li: HTMLElement): void {
    const item = readItem(li);
    const feedback = q<HTMLElement>(li, '[data-check-feedback]');
    const verdict = q<HTMLElement>(li, '[data-check-verdict]');
    if (!item || !feedback || !verdict) return;

    const input = q<HTMLInputElement>(li, 'input[name="answer"]');
    const answer = item.type === 'numeric' ? (input?.value ?? '') : chosenIndex(li);
    const result = grade(item, answer ?? '', { params: instances.get(li) });
    if (!result.supported) return;

    const explanation = q<HTMLElement>(li, '[data-check-explanation]');
    const optionExplanations = li.querySelectorAll<HTMLElement>('[data-check-option-explanation]');
    const pitfall = q<HTMLAnchorElement>(li, '[data-check-pitfall-link]');
    const derivation = q<HTMLAnchorElement>(li, '[data-check-derivation-link]');
    const reset = q<HTMLButtonElement>(li, '[data-check-action="reset"]');

    optionExplanations.forEach((el) => (el.hidden = true));
    if (pitfall) pitfall.hidden = true;
    if (derivation) derivation.hidden = true;

    if (result.message) {
      li.dataset['checkState'] = 'invalid';
      verdict.textContent = result.message;
      if (explanation) explanation.hidden = true;
      input?.setAttribute('aria-invalid', 'true');
      feedback.hidden = false;
      return;
    }

    input?.removeAttribute('aria-invalid');
    const state = result.correct ? 'correct' : 'incorrect';
    li.dataset['checkState'] = state;
    verdict.textContent = result.correct ? 'Correct.' : 'Not quite.';

    // The chosen option's own explanation replaces the item's when it has one.
    const chosen = typeof answer === 'number' ? answer : -1;
    let shownOwn = false;
    optionExplanations.forEach((el) => {
      if (Number(el.dataset['checkOptionExplanation']) === chosen) {
        el.hidden = false;
        shownOwn = true;
      }
    });
    if (explanation) explanation.hidden = shownOwn;

    if (!result.correct) {
      const misconception = result.misconception;
      const href = misconception ? pitfallHref(misconception) : null;
      if (pitfall && href) {
        pitfall.href = href;
        pitfall.hidden = false;
      }
      const target = li.dataset['checkTargets'] ? firstOnPage(li.dataset['checkTargets']) : null;
      if (derivation && target) {
        derivation.href = `#${target.id}`;
        derivation.textContent = target.step
          ? `Go to step ${target.id.replace(/^.*-step-/, '')}`
          : 'Go to the derivation';
        derivation.hidden = false;
      }
    }

    feedback.hidden = false;
    if (reset) reset.hidden = false;
    li.dispatchEvent(
      new CustomEvent('check:graded', {
        bubbles: true,
        detail: { id: li.dataset['checkItem'], type: item.type, correct: result.correct },
      }),
    );
  }

  function resetItem(li: HTMLElement): void {
    const feedback = q<HTMLElement>(li, '[data-check-feedback]');
    const reset = q<HTMLButtonElement>(li, '[data-check-action="reset"]');
    li.dataset['checkState'] = 'idle';
    if (feedback) feedback.hidden = true;
    if (reset) reset.hidden = true;
    li.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(
      (r) => (r.checked = false),
    );
    const input = q<HTMLInputElement>(li, 'input[name="answer"]');
    if (input) {
      input.value = '';
      input.removeAttribute('aria-invalid');
      input.focus();
    } else {
      q<HTMLInputElement>(li, 'input[type="radio"]')?.focus();
    }
  }

  function resampleItem(li: HTMLElement): void {
    const item = readItem(li);
    if (!item || item.type !== 'numeric') return;
    const n = (resamples.get(li) ?? 0) + 1;
    resamples.set(li, n);
    const { params } = sampleSeededParams(item, hashSeed(li.dataset['checkItem'] ?? '') + n);
    instances.set(li, params);
    li.dataset['checkParams'] = JSON.stringify(params);
    const box = q<HTMLElement>(li, '[data-check-params]');
    const list = q<HTMLElement>(li, '[data-check-params-list]');
    if (list) {
      list.textContent = Object.entries(params)
        .map(([k, v]) => `${k} = ${v}`)
        .join(', ');
    }
    if (box) box.hidden = false;
    resetItem(li);
  }

  document.addEventListener('submit', (event) => {
    const form = (event.target as Element | null)?.closest('[data-check-form]');
    const li = form?.closest<HTMLElement>(ITEM);
    if (!li) return;
    event.preventDefault();
    gradeItem(li);
  });

  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-check-action]');
    const li = button?.closest<HTMLElement>(ITEM);
    if (!button || !li) return;
    const action = button.dataset['checkAction'];
    if (action === 'reset') resetItem(li);
    else if (action === 'resample') resampleItem(li);
  });
</script>
