    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Options */
  .check-options {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .check-option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.6rem;
    min-height: 2.75rem;
    margin: 0;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-control);
    font-size: 0.9444em;
    line-height: 1.5;
    cursor: pointer;
    transition: background-color var(--duration-micro) var(--ease-standard);
  }
  .check-option:hover {
    background: var(--surface-2);
  }
  .check-option input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
    margin: 0;
    transform: translateY(0.1em);
    cursor: pointer;
  }
  .check-option-text {
    min-width: 0;
  }
  .check-step {
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
  }
  .check-step-number {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .check-step-math {
    overflow-x: auto;
  }
  .check-step-math :global(.katex-display) {
    margin: 0.15em 0;
    text-align: start;
  }
  .check-step-math :global(.katex-display > .katex) {
    text-align: start;
  }

  /* Numeric */
  .check-params {
    margin: 0 0 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--fg);
  }
  .check-params code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .check-answer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
