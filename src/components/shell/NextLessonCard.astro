---
interface Props {
  prev?: { href: string; number: string; title: string } | undefined;
  next?: { href: string; number: string; title: string } | undefined;
}
const { prev, next } = Astro.props;
---

<nav aria-label="Lesson navigation" class="mt-12 grid gap-3 font-sans sm:grid-cols-2">
  {prev ? (
    <a
      href={prev.href}
      class="rounded-card border border-border bg-surface p-4 text-fg no-underline transition-colors duration-micro ease-standard hover:bg-surface-2"
    >
      <span class="block text-ui-xs tracking-caps text-muted uppercase">Previous</span>
      <span class="block text-ui-lg font-semibold">
        {prev.number} · {prev.title}
      </span>
    </a>
  ) : (
    <span />
  )}
  {next && (
    <a
      href={next.href}
      class="rounded-card border border-border bg-surface p-4 text-right text-fg no-underline transition-colors duration-micro ease-standard hover:bg-surface-2"
    >
      <span class="block text-ui-xs tracking-caps text-muted uppercase">Next lesson</span>
      <span class="block text-ui-lg font-semibold">
        {next.number} · {next.title}
      </span>
    </a>
  )}
</nav>
