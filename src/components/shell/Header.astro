---
import ThemeToggle from '@/components/shell/ThemeToggle.astro';

const nav = [
  { href: '/units', label: 'Units' },
  { href: '/atlas', label: 'Atlas' },
  { href: '/practice', label: 'Practice' },
  { href: '/glossary', label: 'Glossary' },
];
const current = Astro.url.pathname;
---

<header class="border-b border-border bg-bg font-sans">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-4">
    <a href="/" class="text-fg text-[15px] font-semibold tracking-tight no-underline">
      AML Atlas
    </a>
    <nav aria-label="Primary" class="flex flex-1 items-center gap-1 text-[14px]">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
          class="text-muted hover:bg-surface-2 hover:text-fg aria-[current=page]:text-fg rounded-control px-3 py-2 no-underline transition-colors duration-micro ease-standard"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
