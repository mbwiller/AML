---
import { SITE_NAV } from '@/components/shell/nav';
import ThemeToggle from '@/components/shell/ThemeToggle.astro';

/** Phones get Units, Atlas, Homework; ≥640 px adds Practice and Glossary; ≥768 px the rest. */
const SHOW_FROM = {
  all: 'inline-flex',
  sm: 'hidden sm:inline-flex',
  md: 'hidden md:inline-flex',
} as const;
const current = Astro.url.pathname;
---

<header class="border-b border-border bg-bg font-sans">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:gap-6">
    <a
      href="/"
      class="text-fg text-ui-lg font-semibold tracking-tight whitespace-nowrap no-underline"
    >
      AML Atlas
    </a>
    <nav
      aria-label="Primary"
      class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto text-ui whitespace-nowrap"
    >
      {SITE_NAV.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            SHOW_FROM[item.header],
            'text-muted hover:bg-surface-2 hover:text-fg aria-[current=page]:text-fg rounded-control px-2 py-2 no-underline transition-colors duration-micro ease-standard sm:px-3',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
